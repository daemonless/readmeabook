name = "postgresql";
provides = ["postgresql"];
type = "simple";
enable = true;
command = "/daemonless/libexec/postgresql";
# Fast shutdown: smart (TERM) waits for the app's connections, and rcd stops
# units one at a time.
sig_stop = "INT";
process { env_file = "/run/rcd.env"; }
restart { policy = "always"; max_retries = 0; delay = 5000; backoff = "none"; }
